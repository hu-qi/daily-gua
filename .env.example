# 本地运行用：复制为 .env（已被 .gitignore 忽略），不要把真实密钥提交进仓库。
# Actions 里这些值由 Settings → Secrets and variables → Actions 注入，不需要 .env。

# —— 必填（缺失时自动降级为「公开发布镜像 + RSS」采集、瓜报降级为链接汇总）——
LLM_BASE_URL=https://your-openai-compatible-gateway.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=antigravity/gemini-3.8-flash

# —— 可选：X 官方 API（缺省走公开镜像兜底）——
X_BEARER_TOKEN=
X_KEYWORDS=AI 翻车,大模型 争议
X_HANDLES=AnthropicAI,OpenAI,sama

# —— 可选：采集与发布 ——
SEED_URLS=https://x.com/criscxuan/status/2120336410989433287
RSS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/,https://www.theverge.com/rss/ai-artificial-intelligence/index.xml
X_MIRROR_BASE=https://api.fxtwitter.com
X_MIRROR_ENABLED=true

# —— 可选：GitHub 发布（Actions 里由平台注入 GITHUB_TOKEN / GITHUB_REPOSITORY）——
GITHUB_TOKEN=
GITHUB_REPOSITORY=hu-qi/daily-gua
SITE_URL=https://hu-qi.github.io/daily-gua

# —— 可选：调参 ——
HTTP_TIMEOUT_S=15
HTTP_RETRIES=3
LLM_TIMEOUT_S=90
LLM_MAX_TOKENS=4096
LLM_TOKEN_BUDGET=24000
